# ---------- Servidor ----------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ---------- Base de datos (PostgreSQL) ----------
# Formato: postgresql://USUARIO:CONTRASEÑA@localhost:5432/NOMBRE_DB
# En Windows/Mac con el instalador oficial el usuario es "postgres" y la contraseña la que elegiste al instalar.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chippi

# ---------- Autenticación ----------
# Generar uno seguro con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---------- Email (para módulos posteriores: campañas, recordatorios, facturas) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Chippi <no-reply@chippi.app>"
